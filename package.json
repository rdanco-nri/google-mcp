{
  "name": "google-mcp",
  "private": true,
  "version": "0.35.0",
  "description": "MCP server for Gmail, Drive, Docs, Sheets, Slides, and Calendar, with scope-gated tools and path jails on attachments and downloads.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-mcp": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup",
    "start": "node dist/index.js",
    "auth": "node dist/index.js auth",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "gmail",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai",
    "llm",
    "agent-tools",
    "oauth",
    "claude",
    "cursor",
    "typescript",
    "nodejs",
    "google-drive",
    "google-docs",
    "google-sheets",
    "google-slides",
    "google-calendar"
  ],
  "author": "Rob Danco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rdanco-nri/google-mcp.git"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "email-addresses": "^5.0.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "htmlparser2": "12.0.0",
    "nodemailer": "^8.0.6",
    "open": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.17",
    "@types/nodemailer": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.7.0",
    "gaxios": "^7.1.4",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

# Gmail OAuth keys. Path to the gcp-oauth.keys.json file downloaded from
# Google Cloud Console (APIs & Services → Credentials → OAuth 2.0 client
# IDs → Desktop app type → Download JSON). Defaults to ~/.google-mcp/
# gcp-oauth.keys.json if unset.
# GOOGLE_MCP_OAUTH_PATH=/abs/path/gcp-oauth.keys.json

# Where the runtime tokens (refresh + access + scope list) are persisted
# after the one-shot `npm run auth` flow. Mode 0o600. Default
# is ~/.google-mcp/credentials.json.
# GOOGLE_MCP_CREDENTIALS_PATH=/abs/path/credentials.json

# --- Safeguards (all optional) ---

# Folder that email attachments and Drive uploads must come from.
# Default ~/GoogleMCP/attachments, created at mode 0o700.
# GOOGLE_MCP_ATTACHMENT_DIR=/abs/path

# Folder that downloaded emails, attachments, and Drive files go to.
# Default ~/GoogleMCP/downloads, created at mode 0o700.
# GOOGLE_MCP_DOWNLOAD_DIR=/abs/path

# Every write tool returns the payload it would have sent, without
# calling Google. Read tools ignore it.
# GOOGLE_MCP_DRY_RUN=true

# Per-bucket write caps. Buckets and defaults: send 100/day,2000/month;
# delete 200/2000; modify 500/5000; drafts 300/3000; labels 50/500;
# filters 20/200; workspace_writes (comment replies, deck writes) 100/1500.
# GOOGLE_MCP_RATE_LIMIT_DISABLE=true turns the limiter off.
# GOOGLE_MCP_RATE_LIMIT_send=400/day,6000/month

# Where the rate-limit history is kept. Default ~/.google-mcp.
# GOOGLE_MCP_STATE_DIR=/abs/path

# Append-only redacted JSONL audit log of every tool call. Sender + Gmail
# IDs + scopes + result are kept; subject / body / attachments are
# elided by default. Must be an absolute path; mode 0o600 enforced.
# GOOGLE_MCP_AUDIT_LOG=/abs/path/audit.jsonl

# Verbose audit: include subject + body excerpts (counterparty PII).
# OFF by default. Only enable for debugging on a private machine — the
# audit log will then contain inbox content.
# GOOGLE_MCP_AUDIT_LOG_VERBOSE=true

# --- Recipient-pairing gate (opt-in) ---

# When set to true, every send_email / reply_all / draft_email recipient
# (To/Cc/Bcc) must appear in ~/.google-mcp/paired.json (managed via the
# pair_recipient tool). Caps the blast radius of a prompt-injection-driven
# send. OFF by default — legacy users see no change.
# GOOGLE_MCP_RECIPIENT_PAIRING=true

# Override paired.json location (defaults to ~/.google-mcp/paired.json,
# mode 0o600).
# GOOGLE_MCP_PAIRED_PATH=/abs/path/paired.json
